{% doc %}
  Inline SVG icon. Decorative by default: pair with visible text or an
  aria-label on the parent control.

  @param {string} name - sun, moon, cart, search, account, menu, close, plus, minus, heart, arrow-right, check, chevron-down, grid, list, truck, return, shield, leaf, star, gift, support, lock, clock, package
  @param {string} [class] - Extra class on the svg

  The menu icon is two separate paths on purpose: the header turns them into an X
  with CSS while the menu is open (base.css, .nav-toggle path).

  @example
  {% render 'icon', name: 'cart' %}
{% enddoc %}

<svg class="icon{% if name == 'arrow-right' %} icon--flip{% endif %} {{ class }}" viewBox="0 0 24 24" aria-hidden="true">
  {%- case name -%}
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
    {%- when 'moon' -%}
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
    {%- when 'cart' -%}
      <path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
    {%- when 'menu' -%}
      <path d="M3 8h18"/><path d="M3 16h18"/>
    {%- when 'heart' -%}
      <path d="M12 20.5s-8-4.9-8-11A4.5 4.5 0 0 1 12 6.8 4.5 4.5 0 0 1 20 9.5c0 6.1-8 11-8 11z"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14m-6-6 6 6-6 6"/>
    {%- when 'check' -%}
      <path d="m5 12 5 5L20 7"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'grid' -%}
      <rect x="4" y="4" width="6" height="6"/><rect x="14" y="4" width="6" height="6"/><rect x="4" y="14" width="6" height="6"/><rect x="14" y="14" width="6" height="6"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>
    {%- when 'return' -%}
      <path d="M8 4 4 8l4 4"/><path d="M4 8h10a6 6 0 0 1 0 12H8"/>
    {%- when 'shield' -%}
      <path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'leaf' -%}
      <path d="M5 19C5 10 10 5 20 5c0 10-5 15-14 15"/><path d="M5 19 13 11"/>
    {%- when 'star' -%}
      <path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>
    {%- when 'gift' -%}
      <path d="M4 10h16v10H4z"/><path d="M3 6h18v4H3z"/><path d="M12 6v14"/>
    {%- when 'support' -%}
      <path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1"/><rect x="17" y="14" width="4" height="6" rx="1"/>
    {%- when 'lock' -%}
      <rect x="5" y="11" width="14" height="9" rx="1"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'package' -%}
      <path d="M12 3 4 7v10l8 4 8-4V7z"/><path d="m4 7 8 4 8-4M12 11v10"/>
    {%- when 'list' -%}
      <path d="M9 6h11M9 12h11M9 18h11"/><path d="M4 6h.01M4 12h.01M4 18h.01"/>
  {%- endcase -%}
</svg>{%- comment -%}Whitespace control: no trailing newline, so an inline icon never gains a stray space before the text next to it.{%- endcomment -%}