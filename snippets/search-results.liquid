{% doc %}
  The results under the header search field (one ARIA listbox) and their styles. Rendered by
  sections/predictive-search.liquid for each request, and rendered once, empty, by the header so
  these styles are on every page: the section is only ever fetched, never placed, so a
  stylesheet of its own would never reach the page.

  Two parts:
  1. Suggestions (the search terms Shopify proposes, then matching collections) are the lower part
     of the search box: they share one border with the field, like Google's extended input.
  2. Below the box: the first three matching products (so the whole list fits a phone screen
     without scrolling), pages and articles, and a "Show all for ..." button that goes to the
     full results page.

  The links are the options (role="option"); the input is the combobox and points at the active
  one with aria-activedescendant while focus stays in the field. They are also normal tab stops: Tab goes from
  the field to the suggestions, then the products, pages and the button. data-status carries the sentence announced in a live region.

  @param {object} [results] - The predictive_search object (only available in the section, so it is passed in)

  @example
  {% render 'search-results', results: predictive_search %}
{% enddoc %}

{%- if results.performed -%}
  {%- liquid
    assign found = results.resources
    assign shown_products = found.products.size | at_most: 3
    assign total = found.queries.size | plus: found.collections.size | plus: shown_products | plus: found.pages.size | plus: found.articles.size
    assign encoded_terms = results.terms | url_encode
  -%}
  <div id="search-listbox" role="listbox" aria-label="{{ 'search.label' | t }}" data-status="{% if total == 0 %}{{ 'search.no_results' | t | escape }}{% else %}{{ 'search.results_status' | t: count: total | escape }}{% endif %}">
    {%- if found.queries.size > 0 or found.collections.size > 0 -%}
      <ul class="search__suggestions" role="group" aria-label="{{ 'search.suggestions' | t }}">
        {%- for query in found.queries -%}
          <li role="presentation"><a id="search-option-query-{{ forloop.index }}" role="option" href="{{ query.url }}"><span>{{ query.styled_text }}</span></a></li>
        {%- endfor -%}
        {%- for collection in found.collections -%}
          <li role="presentation"><a id="search-option-collection-{{ forloop.index }}" role="option" href="{{ collection.url }}">{{ collection.title }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="search__matches">
      {%- if shown_products > 0 -%}
        <ul role="group" aria-label="{{ 'search.products' | t }}">
          {%- for product in found.products limit: 3 -%}
            <li role="presentation">
              <a id="search-option-product-{{ forloop.index }}" class="search__product" role="option" href="{{ product.url }}">
                {%- if product.featured_image -%}
                  {%- render 'image', image: product.featured_image, sizes: '48px', widths: '48, 96, 144', width: 144, decorative: true -%}
                {%- else -%}
                  <span class="search__thumb"></span>
                {%- endif -%}
                <span class="search__info">
                  <span class="search__title">{{ product.title }}</span>
                  {%- render 'price', price: product.price, compare_at_price: product.compare_at_price -%}
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if found.pages.size > 0 or found.articles.size > 0 -%}
        <ul role="group" aria-label="{{ 'search.pages' | t }}">
          {%- for page in found.pages -%}
            <li role="presentation"><a id="search-option-page-{{ forloop.index }}" role="option" href="{{ page.url }}"><span class="search__line">{{ page.title }}</span></a></li>
          {%- endfor -%}
          {%- for article in found.articles -%}
            <li role="presentation"><a id="search-option-article-{{ forloop.index }}" role="option" href="{{ article.url }}"><span class="search__line">{{ article.title }}</span></a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <ul class="search__more" role="group">
        <li role="presentation"><a id="search-option-all" class="button button--block" role="option" href="{{ routes.search_url }}?q={{ encoded_terms }}&amp;options%5Bprefix%5D=last">{{ 'search.show_all' | t: terms: results.terms }}</a></li>
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* One value for every gap in the drawer (--space, defined on .search in sections/header.liquid), measured in visible space between content: above the first suggestion, between
     suggestions, below the last, under the box and on both sides of every divider. A text row is one line (--line) plus --space, so its
     own air is half of --space and the rows' pitch is the same gap everywhere. The rows are full width, so their height is no obstacle
     to a tap, and 40px is well above the 24px WCAG 2.5.8 asks for. Thumbnail rows and the button have none; a group pads by
     --space minus its own air. */
  /* --ink is the few pixels of air inside a text line between its box and the letters. A hairline, a box edge, a thumbnail or the
     button has none, so next to text a gap looks --ink roomier than the same box gap next to one of those. Wherever one side of an
     edge is hard, that side gets --ink extra, so both sides of every line look the same, and the first and last suggestion are as
     far from the box as suggestions are from each other. */
  .search__results ul { margin: 0; padding: 0; list-style: none; }

  /* 1. Suggestions: the lower part of the search box. The field above loses its bottom corners and gets a hairline instead of a full
     border, so the two read as one shape. Rows run the full width of the box, their text inset 16px, level with the text in the field.
     Its background is a 50% layer of the page color over the panel's 90% glass: 95% opaque in all, halfway between the glass and the
     fully solid field above it. */
  .search__suggestions { border: 1px solid var(--color-control); border-block-start: 0; border-radius: 0 0 var(--radius) var(--radius); background: color-mix(in srgb, var(--color-bg) 50%, transparent); }
  /* The air above the first row and below the last is padding of those rows, so their tap area and hover highlight reach the box edges. */
  .search__results .search__suggestions { --air: calc(var(--space) / 2); --edge: calc(var(--space) - var(--air) + var(--ink) / 2); padding-block: 0; }
  .search__suggestions li:first-child a { padding-block-start: calc(0.375rem + var(--edge)); min-height: calc(var(--line) + var(--space) + var(--edge)); }
  .search__suggestions li:last-child a { padding-block-end: calc(0.375rem + var(--edge)); min-height: calc(var(--line) + var(--space) + var(--edge)); }
  .search__suggestions li:only-child a { min-height: calc(var(--line) + var(--space) + 2 * var(--edge)); }
  /* The box clips the hover highlight to its rounded corners. */
  .search__results .search__suggestions { overflow: clip; }
  .search:has(.search__suggestions) input[type='search'] { border-end-start-radius: 0; border-end-end-radius: 0; border-block-end-color: var(--color-border); }
  .search__suggestions a { display: flex; align-items: center; min-height: calc(var(--line) + var(--space)); padding: 0.375rem 1rem; text-decoration: none; }
  .search__suggestions a[aria-selected='true'] { background: var(--color-surface); }
  /* The focus ring of a row is drawn inside it: the panel scrolls, so a ring outside the full-width row would be clipped. */
  .search__suggestions a:focus-visible, .search__matches a:not(.button):focus-visible { outline-offset: -2px; }

  /* 2. Below the box: the parts of the drawer, set apart by --part (the same as --space on a phone, roomier on a desktop, see the header).
     The divider is a 1px top border, so a group after it pads 1px less on top. The last group has no bottom padding:
     the panel's own 16px, like its sides, finishes it. */
  .search__matches [role='group'] { --air: calc(var(--space) / 2); --hard: 0px; padding-block: calc(var(--part) - var(--air) + var(--hard)); }
  .search__matches [role='group']:has(.search__product) { --air: 0px; --hard: var(--ink); }
  .search__matches [role='group']:has(.button) { --air: 0px; --hard: var(--ink); }
  .search__matches [role='group'] + [role='group'] { padding-block-start: calc(var(--part) - var(--air) + var(--hard) - 1px); border-block-start: 1px solid var(--color-border); }
  .search__matches [role='group']:first-child { padding-block-start: calc(var(--part) - var(--air) + var(--hard)); }
  .search__matches [role='group']:last-child { padding-block-end: 0; }
  /* These rows are exactly as wide as the list: the hover highlight, the focus ring and the tap area end where the list ends, with no
     negative margin spilling past it. Their content starts flush at the list's start edge (the box's outer edge, in line with the
     field and the button), with no indent: thumbnails and page titles sit on that edge, and a little room is left at the end. */
  .search__matches a:not(.button) { display: flex; align-items: center; gap: 0.75rem; min-height: calc(var(--line) + var(--space)); padding-block: 0.375rem; padding-inline: 0 1rem; border-radius: var(--radius); text-decoration: none; }
  /* A product row is exactly as tall as its thumbnail: the hover highlight and focus ring wrap the thumbnail with no padding above or below.
     The space between two product rows is a real gap instead (12px), so a thumbnail has no air to account for (--air: 0). */
  .search__matches a.search__product { padding-block: 0; }
  .search__matches [role='group']:has(.search__product) li + li { margin-block-start: 0.75rem; }
  .search__matches a:not(.button)[aria-selected='true'] { background: var(--color-surface); }
  /* Hover highlights only on devices that can hover: on a touch screen :hover sticks to whatever is under the finger and lights rows up while scrolling. */
  @media (hover: hover) {
    .search__suggestions a:hover, .search__matches a:not(.button):hover { background: var(--color-surface); }
  }
  /* The last option is the theme's primary button. The highlight from the arrow keys is a ring, since a fill would change its color. */
  .search__matches .button[aria-selected='true'] { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .search__results mark { background: none; color: inherit; font-weight: var(--font-weight-strong); }
  .search__product img, .search__thumb { flex: none; width: 3rem; height: 3.75rem; border-radius: var(--radius); object-fit: cover; background: var(--color-surface); }
  .search__info { display: grid; align-content: center; gap: 0.125rem; min-width: 0; }
  .search__line { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .search__title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: var(--font-weight-strong); }
{% endstylesheet %}
