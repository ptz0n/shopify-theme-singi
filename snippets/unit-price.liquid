{% doc %}
  Unit price of a variant, for comparing sizes: "$78.00 / 100 ml". Renders nothing when the
  variant has no unit price set. Shopify's own filter (unit_price_with_measurement) prints
  "$78.00/100ml" and cannot be spaced, so the pieces are formatted here: the price with the
  store's money format, a reference value of 1 left out ("$24.00 / L", not "/ 1 L"), and unit
  symbols written the usual way (L, m², ft²). Shopify returns the unit lowercase.

  Screen readers get a full sentence instead of the slash (products.unit_price_per, for example
  "$78.00 per 100 ml"), so each language keeps its own word order.

  @param {variant} variant - The variant
  @param {string} [part] - 'visible' for the text shown, 'label' for the screen reader sentence.
    Both are plain text with ordinary spaces (assets/product-form.js reads them from data
    attributes). Default: the finished <p> with both.

  @example
  {% render 'unit-price', variant: product.selected_or_first_available_variant %}
{% enddoc %}

{%- liquid
  assign measurement = variant.unit_price_measurement
  if measurement
    assign amount = variant.unit_price | money
    assign unit = measurement.reference_unit
    case unit
      when 'l'
        assign unit = 'L'
      when 'm2'
        assign unit = 'm²'
      when 'm3'
        assign unit = 'm³'
      when 'ft2'
        assign unit = 'ft²'
      when 'yd2'
        assign unit = 'yd²'
      when 'floz'
        assign unit = 'fl oz'
    endcase
    assign reference = unit
    if measurement.reference_value != 1
      assign reference = measurement.reference_value | append: ' ' | append: unit
    endif
    assign visible = amount | append: ' / ' | append: reference
    assign label = 'products.unit_price_per' | t: price: amount, reference: reference
  endif
-%}

{%- if measurement -%}
  {%- case part -%}
    {%- when 'visible' -%}{{ visible }}
    {%- when 'label' -%}{{ label }}
    {%- else -%}
      <p class="muted mono product-price__unit"><span aria-hidden="true">{{ visible | replace: ' ', '&nbsp;' }}</span><span class="visually-hidden">{{ label }}</span></p>
  {%- endcase -%}
{%- endif -%}
