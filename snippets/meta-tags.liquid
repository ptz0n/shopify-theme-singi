{% doc %}
  Everything SEO and social that belongs in <head>: charset, viewport, title,
  description, canonical, robots, hreflang, Open Graph, Twitter, theme-color,
  favicon and page-level JSON-LD. Rendered first in layout/theme.liquid so the
  charset lands inside the first 1024 bytes.

  @example
  {% render 'meta-tags' %}
{% enddoc %}

{%- liquid
  assign meta_title = page_title | default: shop.name
  assign meta_description = page_description | default: shop.description | default: shop.name
  assign meta_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign noindex = false
  assign tag_list = current_tags | join: ', '

  case request.page_type
    when 'product'
      assign og_type = 'product'
    when 'article'
      assign og_type = 'article'
    when 'search'
      assign noindex = true
    when 'page'
      if template.suffix == 'styleguide'
        assign noindex = true
      endif
    when 'password'
      assign meta_url = request.origin
  endcase
-%}

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="{{ settings.light_background }}" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="{{ settings.dark_background }}" media="(prefers-color-scheme: dark)">

<title>
  {{- page_title -}}
  {%- if current_tags %} &ndash; {{ 'general.tagged' | t: tags: tag_list }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.page_number' | t: number: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<meta name="description" content="{{ meta_description | strip_html | strip_newlines | truncate: 320 | escape }}">
<link rel="canonical" href="{{ meta_url }}">

{%- if noindex %}
  <meta name="robots" content="noindex, follow">
{%- endif %}

{%- comment %} Without a favicon the browser still asks for /favicon.ico, gets a 404 and logs a console error (a Lighthouse best-practices failure). An empty data icon stops the request. {%- endcomment %}
{%- if settings.favicon != blank %}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
{%- else %}
  <link rel="icon" href="data:,">
{%- endif %}

{%- if localization.available_languages.size > 1 %}
  {%- for language in localization.available_languages %}
    <link rel="alternate" hreflang="{{ language.iso_code }}" href="{{ language.root_url | remove_first: '/' | prepend: request.origin | append: request.path | replace: '//', '/' | replace: ':/', '://' }}">
  {%- endfor %}
{%- endif %}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ meta_url }}">
<meta property="og:title" content="{{ meta_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ meta_description | strip_html | strip_newlines | truncate: 320 | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code }}">

{%- if page_image %}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ page_image.width | at_most: 1200 }}">
  <meta property="og:image:alt" content="{{ page_image.alt | default: meta_title | escape }}">
{%- endif %}

<meta name="twitter:card" content="{% if page_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ meta_title | escape }}">
<meta name="twitter:description" content="{{ meta_description | strip_html | strip_newlines | truncate: 200 | escape }}">

{%- if request.page_type == 'product' %}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <script type="application/ld+json">{{ product | structured_data }}</script>
{%- elsif request.page_type == 'index' %}
  {%- render 'schema-site' -%}
{%- elsif request.page_type == 'article' %}
  {%- render 'schema-article' -%}
{%- endif %}
