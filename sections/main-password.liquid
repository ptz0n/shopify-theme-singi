{% comment %}
  Storefront password page, rendered in layout/password.liquid. A centered card
  over a soft accent glow (static for reduced motion). Accessible: a real label,
  an error that is announced and tied to the field with aria-describedby, a visible
  focus ring, dark mode and RTL through the shared tokens.

  Where it shows: on a real store, to visitors, in layout/password.liquid. On a
  development store Shopify always serves its own password page to visitors (a
  custom one cannot replace it, see the password template docs), so there this page
  only appears to the signed-in owner at /password, inside the normal theme layout.
  The page therefore also behaves inside layout/theme.liquid: no second theme toggle
  (the header has one) and no extra full-screen height under the header.
{% endcomment %}

<div class="pw">
  <div class="pw__glow" aria-hidden="true"></div>

  {%- if settings.show_theme_toggle -%}
    <button class="icon-button theme-toggle pw__toggle" type="button" data-theme-toggle aria-label="{{ 'general.toggle_theme' | t }}">
      {%- render 'icon', name: 'sun', class: 'i-sun' -%}
      {%- render 'icon', name: 'moon', class: 'i-moon' -%}
    </button>
  {%- endif -%}

  <div class="pw__card stack">
    <p class="pw__brand">
      {%- if settings.logo != blank -%}
        {%- assign logo_sizes = settings.logo_width | append: 'px' -%}
        {%- render 'image',
          image: settings.logo,
          sizes: logo_sizes,
          widths: '96, 192, 288, 384, 480',
          width: 480,
          alt: shop.name,
          priority: true
        -%}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </p>

    <h1>{{ 'password.title' | t }}</h1>

    {%- if shop.password_message != blank -%}
      <div class="muted prose">{{ shop.password_message }}</div>
    {%- endif -%}

    {%- form 'storefront_password', class: 'pw__form' -%}
      <div class="field">
        <label for="password-input">{{ 'password.label' | t }}</label>
        <input
          id="password-input"
          type="password"
          name="password"
          autocomplete="current-password"
          autocapitalize="off"
          spellcheck="false"
          autofocus
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="password-error"
          {% endif %}
        >
        {%- if form.errors -%}
          <div class="field__error" id="password-error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
      </div>
      <button class="button button--block" type="submit">{{ 'password.enter' | t }}</button>
    {%- endform -%}

    <p class="pw__owner">
      <a href="/admin">{{ 'password.owner' | t }}</a>
    </p>
  </div>
</div>

{% stylesheet %}
  .pw { position: relative; display: grid; place-items: center; min-height: 100svh; padding: var(--gutter); overflow: hidden; }
  .pw__glow { position: absolute; inset: -25%; background: radial-gradient(38rem 38rem at 18% 12%, color-mix(in srgb, var(--color-accent) 24%, transparent), transparent 62%), radial-gradient(34rem 34rem at 86% 92%, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent 62%); filter: blur(24px); pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) {
    .pw__glow { animation: pw-drift 28s ease-in-out infinite alternate; }
  }
  @keyframes pw-drift { to { transform: translate3d(2%, -2%, 0) scale(1.06); } }
  .pw__form { display: grid; gap: 1rem; }
  html[data-layout='theme'] .pw { min-height: calc(100svh - var(--header-h)); }
  html[data-layout='theme'] .pw__toggle { display: none; }
  .pw__toggle { position: absolute; inset-block-start: 1rem; inset-inline-end: 1rem; z-index: 1; }
  .pw__card { --stack: 1rem; position: relative; width: min(100%, 26rem); padding: clamp(1.5rem, 5vw, 2.5rem); border: 1px solid var(--color-border); border-radius: calc(var(--radius) * 2); background: color-mix(in srgb, var(--color-bg) 84%, transparent); backdrop-filter: blur(16px); }
  .pw__brand { font-weight: var(--font-weight-strong); font-size: 1.125rem; letter-spacing: var(--tracking-tight); }
  .pw__brand img { width: var(--logo-width); height: auto; }
  .pw__card h1 { font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2rem); }
  .pw__owner { font-size: 0.875rem; }
  .pw__owner a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--color-muted); }
{% endstylesheet %}

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
