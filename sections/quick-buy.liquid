{% comment %}
  The content of the quick buy dialog on product cards. Never placed on a page: assets/quick-buy.js fetches it
  from /products/<handle>?section_id=quick-buy (Section Rendering API) and puts it in one native dialog, so the
  product is the page's product here. It is the product page's own price, variant picker and buy buttons blocks
  (static, private blocks) inside a <product-form>, so choosing options and adding work as on the product page,
  and a variant change re-fetches this same section. blocks/_buy-buttons.liquid leaves out the sticky bar and the
  dynamic checkout buttons when it renders here. Decision record: docs/decisions/022-quick-buy-is-the-product-form-in-a-dialog.md.
{% endcomment %}

{%- assign variant = product.selected_or_first_available_variant -%}
{%- if settings.tracking_enabled -%}
  {%- capture tracking_item -%}{%- render 'tracking-item', product: product, variant: variant -%}{%- endcapture -%}
{%- endif -%}

{%- assign image = variant.featured_image | default: product.featured_image -%}

<div data-quick-buy-panel data-title="{{ product.title | escape }}">
  <div data-close-row>
    <button class="icon-button" type="button" data-close aria-label="{{ 'general.close' | t }}">
      {%- render 'icon', name: 'close' -%}
    </button>
  </div>
  <product-form
    data-handle="{{ product.handle }}"
    data-type="{{ product.type | escape }}"
    data-section-id="{{ section.id }}"
    data-cart-url="{{ routes.cart_url }}"
    data-added="{{ 'products.added' | t }}"
    data-label-add="{{ 'products.add_to_cart' | t }}"
    data-label-sold-out="{{ 'products.sold_out' | t }}"
    data-error="{{ 'products.add_error' | t }}"
    {% if settings.tracking_enabled %}
      data-item="{{ tracking_item | strip | escape }}"
    {% endif %}
  >
    {%- comment -%}The featured image is a swap region like the price: choosing a variant with its own image changes it.{%- endcomment -%}
    <div data-swap="image">
      {%- if image != blank -%}
        {%- comment -%}A second way to the product page, for the pointer only: the title link is the one a keyboard and a screen reader get.{%- endcomment -%}
        <a href="{{ variant.url | default: product.url }}" tabindex="-1" aria-hidden="true">
          {%- render 'image',
            image: image,
            decorative: true,
            eager: true,
            sizes: '(min-width: 40em) 32rem, 100vw',
            widths: '480, 640, 800, 1000',
            width: 1000
          -%}
        </a>
      {%- endif -%}
    </div>
    <div class="stack">
      <h2 class="h3">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h2>
      {% content_for 'block', type: '_product-price', id: 'price' %}
      {% content_for 'block', type: '_variant-picker', id: 'picker' %}
      {% content_for 'block', type: '_buy-buttons', id: 'buy' %}
    </div>
  </product-form>
</div>

{% schema %}
{
  "name": "Quick buy",
  "settings": []
}
{% endschema %}
