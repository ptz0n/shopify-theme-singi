{% comment %}
  Full-width hero with composable blocks, in two layouts: text over the image (default), or the image beside the text (split: two columns from 48em, the image first on a phone, mirrored in right to left). Below, the overlay layout: an image behind composable blocks. The image is the
  LCP candidate when this is the first section: it gets eager loading,
  fetchpriority=high and a preload hint. Below that position it lazy loads.

  The condition is `section.index > 1` and not `== 1`, because index is nil in
  the theme editor and the Section Rendering API, where the hero must still render.
{% endcomment %}

{%- assign settings_ref = section.settings -%}
{%- capture blocks_html -%}{% content_for 'blocks' %}{%- endcapture -%}
{%- assign blocks_text = blocks_html | strip -%}

{%- comment -%}
  The home page needs exactly one h1 for accessibility and SEO. If this hero has no
  heading block (or no content yet), the shop name is the h1, visually hidden.
{%- endcomment -%}
{%- if request.page_type == 'index' -%}
  {%- unless section.index > 1 or blocks_html contains '<h1' -%}
    <h1 class="visually-hidden">{{ shop.name }}</h1>
  {%- endunless -%}
{%- endif -%}

{%- if settings_ref.image != blank or blocks_text != blank -%}
  <section
    class="hero hero--{{ settings_ref.layout }} hero--{{ settings_ref.height }} hero--{{ settings_ref.align }}"
    style="--overlay: {{ settings_ref.overlay | divided_by: 100.0 }}"
  >
    {%- if settings_ref.image != blank -%}
      <div class="hero__media">
        {%- unless section.index > 1 -%}
          {%- render 'image',
            image: settings_ref.image,
            priority: true,
            sizes: '100vw',
            widths: '640, 960, 1280, 1600, 2000, 2400',
            width: 2400
          -%}
        {%- else -%}
          {%- render 'image', image: settings_ref.image, sizes: '100vw', widths: '640, 960, 1280, 1600, 2000, 2400', width: 2400 -%}
        {%- endunless -%}
        {%- render 'ai-label', alt: settings_ref.image.alt -%}
      </div>
    {%- endif -%}
    <div class="container hero__content stack">
      {{ blocks_html }}
    </div>
  </section>
{%- else -%}
  {%- render 'placeholder', label: 'Hero: choose an image and add blocks', wide: true -%}
{%- endif -%}

{% stylesheet %}
  .hero { position: relative; display: grid; align-items: end; overflow: hidden; background: var(--color-surface); }
  .hero--small { min-height: 40svh; }
  .hero--medium { min-height: 60svh; }
  .hero--large { min-height: 82svh; }
  .hero__media, .hero__media img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__media img { object-fit: cover; }
  .hero__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgb(0 0 0 / var(--overlay)), rgb(0 0 0 / calc(var(--overlay) * 0.4))); }
  .hero__content { position: relative; z-index: 1; padding-block: clamp(2rem, 6vw, 4.5rem); --stack: 1rem; }
  .hero--overlay:has(.hero__media) .hero__content { color: #fff; }
  .hero--overlay:has(.hero__media) .hero__content .button { background: #fff; border-color: #fff; color: #0a0a0b; }
  .hero--overlay:has(.hero__media) .hero__content .button--secondary { background: transparent; color: #fff; border-color: rgb(255 255 255 / 0.6); }
  .hero--overlay:has(.hero__media) .hero__content .muted { color: rgb(255 255 255 / 0.85); }
  .hero--split { align-items: stretch; background: none; }
  .hero--split .hero__media { position: relative; aspect-ratio: 4 / 3; }
  .hero--split .hero__media::after { display: none; }
  .hero--split .hero__content { align-self: center; }
  @media (max-width: 47.99em) { .hero--split { min-height: 0; } }
  @media (min-width: 48em) {
    .hero--split:has(.hero__media) { grid-template-columns: 1fr 1fr; }
    .hero--split .hero__media { aspect-ratio: auto; }
  }
  .hero--center .hero__content { text-align: center; justify-items: center; }
  .hero--end .hero__content { text-align: end; justify-items: end; }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "overlay", "label": "Text over the image" },
        { "value": "split", "label": "Image beside the text" }
      ],
      "default": "overlay",
      "info": "Beside the text, the text sits on the page background, so contrast never depends on the picture. On a phone the image comes first, then the text."
    },
    { "type": "range", "id": "overlay", "label": "Image overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 40, "info": "Only for text over the image. Keep at 40% or more for text contrast." },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Content alignment",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "End" }
      ],
      "default": "start"
    }
  ],
  "blocks": [{ "type": "@theme" }],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "heading", "settings": { "tag": "h1", "size": "xl" } },
        { "type": "text", "settings": { "size": "large" } },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
