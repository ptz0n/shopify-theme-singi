{% comment %}
  A heading and a grid of products from one collection. The heading is always
  rendered (the collection's title when none is set) so the cards' h3 titles never
  follow the page h1 directly.

  Performance notes:
  - `limit` on the for loop caps the database fetch for collection.products.
  - Images in the first row load eagerly only when this section is near the top.
{% endcomment %}

{%- liquid
  assign collection = section.settings.collection
  assign eager_cards = false
  unless section.index > 2
    assign eager_cards = true
  endunless
-%}

{%- if collection != blank -%}
  <section class="container section featured">
    <div class="featured__head">
      <h2>{{ section.settings.heading | default: collection.title }}</h2>
      <a class="featured__all mono" href="{{ collection.url }}">{{ 'sections.featured.view_all' | t }}</a>
    </div>

    {%- assign list_name = section.settings.heading | default: collection.title -%}
    {%- render 'product-grid', collection: collection, limit: section.settings.limit, eager: eager_cards, list_name: list_name, layout: section.settings.layout, label: list_name -%}
  </section>
{%- else -%}
  {%- render 'placeholder', label: 'Featured collection: choose a collection', wide: true -%}
{%- endif -%}

{% stylesheet %}
  .featured__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-block-end: 1.5rem; }
  .featured__all { display: inline-flex; align-items: center; min-height: 2.75rem; margin-inline-start: auto; font-size: 0.8125rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 2, "default": 8 },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "row", "label": "Scrolling row" }
      ],
      "default": "grid",
      "info": "A scrolling row suits a long list on a phone: swipe or scroll sideways, no auto-advance."
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
