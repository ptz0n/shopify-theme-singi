{% comment %}
  Cart page. A normal form post with no JavaScript (quantity update and
  checkout buttons); assets/cart-items.js upgrades it to update lines through
  /cart/change.js and re-render this section via the Section Rendering API.
{% endcomment %}

<div class="container section">
  <h1 tabindex="-1">{{ 'cart.title' | t }}</h1>

  <cart-items
    data-section-id="{{ section.id }}"
    data-change-url="{{ routes.cart_change_url }}.js"
    data-error="{{ 'cart.error' | t }}"
  >
    <p class="form-error" data-error role="alert" hidden></p>
    {%- if settings.tracking_enabled -%}
      {%- render 'tracking-cart' -%}
    {%- endif -%}

    {%- comment -%} The cart object has no `empty` property: item_count is the reliable test. {%- endcomment -%}
    {%- if cart.item_count == 0 -%}
      <div class="cart__empty stack">
        <p>{{ 'cart.empty' | t }}</p>
        <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      </div>
      {%- comment -%} Blocks (recently viewed by default) only fill an empty cart; with items the page is about checking out. {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}<div class="cart__more">{% content_for 'blocks' %}</div>{%- endif -%}
    {%- else -%}
      <form class="cart" action="{{ routes.cart_url }}" method="post">
        <ul class="cart__items" role="list">
          {%- for item in cart.items -%}
            <li class="cart__item">
              <a class="cart__image" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  {%- render 'image', image: item.image, sizes: '96px', widths: '96, 192, 288', width: 288, alt: item.product.title, eager: true -%}
                {%- elsif settings.placeholder_image -%}
                  {%- render 'image', image: settings.placeholder_image, sizes: '96px', widths: '96, 192, 288', width: 288, alt: item.product.title, eager: true -%}
                {%- endif -%}
              </a>
              <div class="cart__info stack" style="--stack: 0.25rem">
                <a class="cart__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="muted mono cart__variant">
                    {%- for option in item.options_with_values -%}
                      {{ option.name }}: {{ option.value }}{% unless forloop.last %}, {% endunless %}
                    {%- endfor -%}
                  </p>
                {%- endunless -%}
                {%- render 'price', price: item.final_price, compare_at_price: item.original_price -%}
              </div>
              <div class="cart__qty">
                <label class="visually-hidden" for="qty-{{ item.index }}">{{ 'products.quantity' | t }}</label>
                {%- assign qty_id = 'qty-' | append: item.index -%}
                {%- render 'quantity-input', id: qty_id, name: 'updates[]', value: item.quantity, min: 0, line: forloop.index -%}
              </div>
              <p class="cart__total mono">{% if settings.price_trim_zeros %}{{ item.final_line_price | money_without_trailing_zeros }}{% else %}{{ item.final_line_price | money }}{% endif %}</p>
              <a class="icon-button cart__remove" href="{{ item.url_to_remove }}" data-remove data-line="{{ forloop.index }}" aria-label="{{ 'cart.remove_item' | t: title: item.product.title }}">
                {%- render 'icon', name: 'close' -%}
              </a>
            </li>
          {%- endfor -%}
        </ul>

        <div class="cart__summary stack">
          <p class="cart__subtotal"><span>{{ 'cart.subtotal' | t }}</span> <span class="mono">{% if settings.price_trim_zeros %}{{ cart.total_price | money_without_trailing_zeros }}{% else %}{{ cart.total_price | money }}{% endif %}</span></p>
          <p class="muted cart__note">{{ 'cart.taxes_note' | t }}</p>
          <noscript><button class="button button--secondary button--block" type="submit" name="update">{{ 'cart.update' | t }}</button></noscript>
          <button class="button button--block" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        </div>
      </form>
    {%- endif -%}
  </cart-items>

  {%- if settings.wishlist_enabled -%}
    {%- render 'wishlist-item' -%}
    <wishlist-list class="wishlist" id="favorites" data-in-cart="{% for item in cart.items %}{{ item.variant_id }}{% unless forloop.last %},{% endunless %}{% endfor %}" data-root="{{ routes.root_url }}" data-title="{{ 'wishlist.title' | t }}" data-add-url="{{ routes.cart_add_url }}.js" data-cart-url="{{ routes.cart_url }}" data-added="{{ 'products.added' | t }}" data-error="{{ 'products.add_error' | t }}" hidden></wishlist-list>
  {%- endif -%}
</div>

<script src="{{ 'cart-items.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .cart { display: grid; gap: 2rem; margin-block-start: 2rem; }
  .cart__items { display: grid; gap: 0; padding: 0; }
  .cart__item { display: grid; grid-template-columns: 5rem 1fr auto; gap: 0.5rem 1rem; align-items: start; padding-block: 1.25rem; border-block-end: 1px solid var(--color-border); }
  .cart__image { display: block; grid-row: span 2; aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius); background: var(--color-surface); }
  .cart__image img { width: 100%; height: 100%; object-fit: cover; }
  .cart__title { display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: var(--font-weight-strong); text-decoration: none; }
  .cart__variant { font-size: 0.8125rem; }
  .cart__remove { grid-column: 3; grid-row: 1; justify-self: end; width: 2.75rem; height: 2.75rem; margin-block-start: -0.5rem; margin-inline-end: -0.5rem; }
  .cart__qty { grid-column: 2; grid-row: 2; }
  .cart__total { grid-column: 3; grid-row: 2; align-self: center; text-align: end; }
  .cart__subtotal { display: flex; justify-content: space-between; font-size: 1.125rem; font-weight: var(--font-weight-strong); }
  .cart__note { font-size: 0.8125rem; }
  .cart__empty { margin-block-start: 2rem; justify-items: start; }
  .cart__more { margin-block-start: 4rem; }
  .wishlist { display: block; margin-block-start: 4rem; }
  .wishlist h2 { margin-block-end: 1.5rem; }
  .wishlist h2:focus { outline: none; }
  .wishlist__items { display: grid; padding: 0; margin: 0; list-style: none; }
  cart-items[aria-busy='true'] .cart { opacity: 0.5; pointer-events: none; }
  @media (min-width: 56em) {
    .cart { grid-template-columns: minmax(0, 1fr) 24rem; align-items: start; }
    .cart__item { grid-template-columns: 6rem 1fr auto 6rem 2.75rem; }
    .cart__image { grid-row: auto; }
    .cart__qty, .cart__total, .cart__remove { grid-column: auto; grid-row: auto; }
    .cart__total { align-self: start; padding-block-start: 0.75rem; }
    .cart__summary { position: sticky; top: calc(var(--header-h) + 1.5rem); padding: 1.5rem; border-radius: var(--radius); background: var(--color-surface); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart",
  "settings": [],
  "blocks": [{ "type": "@theme" }]
}
{% endschema %}
