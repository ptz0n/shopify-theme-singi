{% comment %}
  Product page. The gallery is plain HTML with CSS scroll-snap (no slider JS).
  The details column is a <product-form> custom element (assets/product-form.js)
  that owns variant switching and add-to-cart; its children are the
  merchant-orderable blocks.

  The first image is the LCP candidate: eager, fetchpriority=high, preloaded.
  Every other image lazy loads.
{% endcomment %}

{%- assign variant = product.selected_or_first_available_variant -%}
{%- if settings.tracking_enabled -%}
  {%- capture tracking_item -%}{%- render 'tracking-item', product: product, variant: variant -%}{%- endcapture -%}
{%- endif -%}

<div class="container section product">
  {%- render 'breadcrumbs', kind: 'product' -%}

  <div class="product__layout">
    <div
      class="product__gallery"
      {% if product.media.size > 1 %}
        role="group" aria-label="{{ product.title | escape }}" tabindex="0"
      {% endif %}
    >
      {%- assign first_image = true -%}
      {%- if settings.product_zoom -%}
        {%- assign zoom_total = product.media | where: 'media_type', 'image' | size | at_most: 30 -%}
        {%- assign zoom_position = 0 -%}
      {%- endif -%}
      {%- for media in product.media limit: 30 -%}
        {%- comment -%}3D models are not rendered (docs/media.md): skip the item whole, so it leaves no empty cell in the gallery.{%- endcomment -%}
        {%- if media.media_type == 'model' -%}{%- continue -%}{%- endif -%}
        <div class="product__media" id="media-{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- render 'image',
                image: media,
                priority: first_image,
                sizes: '(min-width: 56em) 55vw, 100vw',
                widths: '480, 720, 960, 1200, 1600',
                width: 1600,
                alt: media.alt
              -%}
              {%- render 'ai-label', alt: media.alt -%}
              {%- if settings.product_zoom -%}
                {%- assign zoom_position = zoom_position | plus: 1 -%}
                {%- capture zoom_variants -%}{%- if product.variants.size > 1 -%}{%- for v in product.variants -%}{%- if v.featured_media.id == media.id -%}{{ v.title }}||{%- endif -%}{%- endfor -%}{%- endif -%}{%- endcapture -%}
                {%- assign zoom_variants = zoom_variants | split: '||' | join: ', ' -%}
                <button
                  class="product__zoom"
                  type="button"
                  data-zoom
                  aria-label="{{ 'products.zoom_open' | t: position: zoom_position, total: zoom_total }}"
                  {%- if zoom_variants != blank %}
                    data-zoom-shown="{{ 'products.zoom_shown_for' | t: variants: zoom_variants | escape }}"
                  {% endif %}
                ></button>
              {%- endif -%}
              {%- assign first_image = false -%}
            {%- when 'video' -%}
              {{-
                media
                | video_tag: image_size: '1200x', controls: true, muted: true, preload: 'none', playsinline: true, aria-label: media.alt
              -}}
            {%- when 'external_video' -%}
              {%- comment -%}Video always starts muted (the viewer can unmute it): the parameter is called mute for YouTube and muted for Vimeo.{%- endcomment -%}
              {%- if media.host == 'youtube' -%}
                {%- comment -%}YouTube is shown as its poster with a play button and loads nothing until pressed (decision 018): none of its title, share and "Watch on YouTube" overlay shows before play. Without JavaScript the poster is a link to the video.{%- endcomment -%}
                <a
                  class="embed"
                  href="https://www.youtube.com/watch?v={{ media.external_id }}"
                  data-embed="https://www.youtube-nocookie.com/embed/{{ media.external_id }}?autoplay=1&mute=1&playsinline=1&rel=0&iv_load_policy=3&color=white"
                  data-title="{{ media.alt | escape }}"
                  aria-label="{{ 'products.video_play' | t: title: media.alt }}"
                >
                  {%- render 'image',
                    image: media.preview_image,
                    sizes: '(min-width: 56em) 55vw, 100vw',
                    widths: '480, 720, 960, 1200, 1600',
                    width: 1600,
                    alt: ''
                  -%}
                  <span class="embed__play" aria-hidden="true"></span>
                </a>
                {%- assign has_embed = true -%}
              {%- elsif media.host == 'vimeo' -%}
                {{- media | external_video_url: muted: '1' | external_video_tag: loading: 'lazy', title: media.alt -}}
              {%- else -%}
                {{- media | external_video_tag: loading: 'lazy', title: media.alt -}}
              {%- endif -%}
          {%- endcase -%}
        </div>
      {%- else -%}
        {%- capture pick -%}{%- render 'placeholder-pick', product: product -%}{%- endcapture -%}
        {%- assign placeholder = settings.placeholder_image -%}
        {%- assign pick = pick | strip -%}
        {%- if pick != blank -%}{%- assign placeholder = shop.metaobjects.singi_placeholder[pick].image.value -%}{%- endif -%}
        {%- if placeholder -%}
          <div class="product__media">
            {%- render 'image',
              image: placeholder,
              priority: true,
              sizes: '(min-width: 56em) 55vw, 100vw',
              widths: '480, 720, 960, 1200, 1600',
              width: 1600,
              alt: product.title
            -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if has_embed -%}<script src="{{ 'embed.js' | asset_url }}" type="module"></script>{%- endif -%}
    {%- if settings.product_zoom -%}{%- render 'product-zoom' -%}{%- endif -%}

    <product-form
      data-handle="{{ product.handle }}"
      data-type="{{ product.type | escape }}"
      class="product__details stack"
      data-section-id="{{ section.id }}"
      data-cart-url="{{ routes.cart_url }}"
      data-variant-media="{{ variant.featured_media.id }}"
      data-added="{{ 'products.added' | t }}"
      data-label-add="{{ 'products.add_to_cart' | t }}"
      data-label-sold-out="{{ 'products.sold_out' | t }}"
      data-error="{{ 'products.add_error' | t }}"
      {% if settings.tracking_enabled %}
        data-item="{{ tracking_item | strip | escape }}"
      {% endif %}
    >
      {% content_for 'blocks' %}
    </product-form>
  </div>
</div>

{%- if settings.tracking_enabled -%}
  <script type="application/json" data-track="view_item">
    {
      "currency": {{ cart.currency.iso_code | json }},
      "value": {{ variant.price | divided_by: 100.0 }},
      "items": [{{ tracking_item | strip }}]
    }
  </script>
{%- endif -%}

<script src="{{ 'product-form.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .product__layout { display: grid; gap: 2rem; }
  .product__gallery { display: grid; gap: 0.75rem; }
  .product__media { position: relative; overflow: hidden; border-radius: var(--radius); background: var(--color-surface); }
  /* Video fills the slot the gallery gives it (on a phone the row is as tall as its square images, in two columns it is as tall as the neighbour): 100% of the stretched cell, and 16:9 only when nothing else sets the row. The YouTube poster covers it, enlarged a little to crop the black bars YouTube bakes into its preview. */
  .embed { position: relative; display: block; width: 100%; height: 100%; aspect-ratio: 16 / 9; overflow: hidden; cursor: pointer; }
  .product__media .embed img { position: absolute; inset: 0; height: 100%; object-fit: cover; scale: 1.34; }
  .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; }
  .embed__play { position: absolute; inset: 50% auto auto 50%; translate: -50% -50%; width: 4rem; height: 4rem; border-radius: 50%; background: var(--color-bg); opacity: 0.9; }
  .embed__play::after { content: ''; position: absolute; inset: 50% auto auto 50%; translate: -35% -50%; width: 1.5rem; height: 1.5rem; background: var(--color-fg); clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .embed:hover .embed__play { opacity: 1; }
  .embed:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -4px; }
  .product__zoom { position: absolute; inset: 0; z-index: 1; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .product__zoom:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -4px; }
  .product__media :is(img, video) { display: block; width: 100%; height: auto; }
  /* The product image format setting (decision 043): every image is cropped to it, as on the cards. Video keeps its own shape. */
  .product__media img { aspect-ratio: var(--ratio-product); object-fit: cover; }
  .product__media video { height: 100%; aspect-ratio: 16 / 9; object-fit: contain; background: #000; }
  .product__media iframe { display: block; width: 100%; height: 100%; aspect-ratio: 16 / 9; border: 0; }
  /* The card image the visitor just clicked (snippets/theme-init.liquid), behind the real image until it arrives. */
  .product__media:first-child { background-image: var(--placeholder, none); background-position: center; background-size: cover; }
  .product__details { --stack: 1.5rem; align-content: start; min-width: 0; }
  @media (max-width: 55.99em) {
    .product__gallery { grid-auto-flow: column; grid-auto-columns: 88%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); }
    .product__media { scroll-snap-align: start; }
    .product__gallery:not([tabindex]) { grid-auto-columns: 100%; overflow: visible; }
  }
  @media (min-width: 56em) {
    .product__layout { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 4rem; align-items: start; }
    .product__gallery { grid-template-columns: repeat(2, 1fr); }
    .product__media:first-child { grid-column: 1 / -1; }
    .product__details { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "settings": [],
  "blocks": [
    { "type": "@app" },
    { "type": "_product-title" },
    { "type": "_product-price" },
    { "type": "_color-siblings" },
    { "type": "_size-guide" },
    { "type": "_product-policies" },
    { "type": "_product-specs" },
    { "type": "_variant-picker" },
    { "type": "_buy-buttons" },
    { "type": "_variants-table" },
    { "type": "_product-description" },
    { "type": "_product-meta" },
    { "type": "@theme" }
  ]
}
{% endschema %}
