{% comment %}
  The cart drawer: one native <dialog> on every page, opened by the header cart link and after an add to cart.
  Without JavaScript the link goes to the cart page and this dialog is never shown. The lines are the same
  <cart-items> element as the cart page, so assets/cart-items.js updates them through the Section Rendering API
  (section id "cart-drawer", from sections/header-group.json). assets/cart-drawer.js opens it and refreshes it
  when the cart changed somewhere else. Turn it off with the setting "Show the cart in a drawer".
  Decision record: docs/decisions/020-cart-drawer-reuses-cart-items.md.
{% endcomment %}

{%- if settings.cart_drawer -%}
  <cart-drawer data-url="{{ routes.root_url }}" data-section-id="{{ section.id }}">
    <dialog class="cart-drawer" aria-label="{{ 'cart.title' | t }}">
      <div class="cart-drawer__panel">
        <div class="cart-drawer__head">
          <h2 class="cart-drawer__title">{{ 'cart.title' | t }}</h2>
          <button class="icon-button" type="button" data-close aria-label="{{ 'general.close' | t }}">
            {%- render 'icon', name: 'close' -%}
          </button>
        </div>

        <cart-items
          class="cart-drawer__content"
          data-section-id="{{ section.id }}"
          data-change-url="{{ routes.cart_change_url }}.js"
          data-error="{{ 'cart.error' | t }}"
        >
          <p class="form-error" data-error role="alert" hidden></p>
          {%- if settings.tracking_enabled -%}
            {%- render 'tracking-cart' -%}
          {%- endif -%}

          {%- if cart.item_count == 0 -%}
            <div class="cart-drawer__empty stack" data-count="0" data-variants="">
              <p>{{ 'cart.empty' | t }}</p>
              <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
            </div>
          {%- else -%}
            <form
              class="cart-drawer__form"
              action="{{ routes.cart_url }}"
              method="post"
              data-count="{{ cart.item_count }}"
              data-variants="{% for item in cart.items %}{{ item.variant_id }}{% unless forloop.last %},{% endunless %}{% endfor %}"
            >
              <ul class="cart-drawer__items" role="list">
                {%- for item in cart.items -%}
                  {%- assign qty_id = 'drawer-qty-' | append: item.index -%}
                  {%- assign rule = item.variant.quantity_rule -%}
                  <li class="cart-drawer__item">
                    <a class="cart-drawer__image" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                      {%- if item.image -%}
                        {%- render 'image',
                          image: item.image,
                          sizes: '64px',
                          widths: '64, 128, 192',
                          width: 192,
                          alt: item.product.title
                        -%}
                      {%- else -%}
                        {%- capture pick -%}{%- render 'placeholder-pick', product: item.product -%}{%- endcapture -%}
                        {%- assign placeholder = settings.placeholder_image -%}
                        {%- assign pick = pick | strip -%}
                        {%- if pick != blank -%}
                          {%- assign placeholder = shop.metaobjects.singi_placeholder[pick].image.value -%}
                        {%- endif -%}
                        {%- if placeholder -%}
                          {%- render 'image',
                            image: placeholder,
                            sizes: '64px',
                            widths: '64, 128, 192',
                            width: 192,
                            alt: item.product.title
                          -%}
                        {%- endif -%}
                      {%- endif -%}
                    </a>
                    <div class="cart-drawer__info stack" style="--stack: 0.25rem">
                      <a class="cart-drawer__link" href="{{ item.url }}">{{ item.product.title }}</a>
                      {%- unless item.product.has_only_default_variant -%}
                        <p class="muted mono cart-drawer__variant">
                          {%- for option in item.options_with_values -%}
                            {{ option.name }}: {{ option.value -}}
                            {%- unless forloop.last %}, {% endunless %}
                          {%- endfor -%}
                        </p>
                      {%- endunless -%}
                      {%- render 'price', price: item.final_price, compare_at_price: item.original_price -%}
                    </div>
                    <a
                      class="icon-button cart-drawer__remove"
                      href="{{ item.url_to_remove }}"
                      data-remove
                      data-line="{{ forloop.index }}"
                      aria-label="{{ 'cart.remove_item' | t: title: item.product.title }}"
                    >
                      {%- render 'icon', name: 'close' -%}
                    </a>
                    <div class="cart-drawer__qty">
                      <label class="visually-hidden" for="{{ qty_id }}">{{ 'products.quantity' | t }}</label>
                      {%- render 'quantity-input',
                        id: qty_id,
                        name: 'updates[]',
                        value: item.quantity,
                        min: rule.min,
                        max: rule.max,
                        increment: rule.increment,
                        hint_max: rule.max,
                        zero: true,
                        line: forloop.index
                      -%}
                    </div>
                  </li>
                {%- endfor -%}
              </ul>

              <div class="cart-drawer__summary stack">
                <p class="cart-drawer__subtotal" data-subtotal>
                  <span>{{ 'cart.subtotal' | t }}</span>
                  <span class="mono">
                    {%- if settings.price_trim_zeros -%}
                      {{- cart.total_price | money_without_trailing_zeros -}}
                    {%- else -%}
                      {{- cart.total_price | money -}}
                    {%- endif -%}
                  </span>
                </p>
                <p class="muted cart-drawer__note">{{ 'cart.taxes_note' | t }}</p>
                <button class="button button--block" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
              </div>
            </form>
          {%- endif -%}
        </cart-items>
      </div>
    </dialog>
  </cart-drawer>

  <script src="{{ 'cart-items.js' | asset_url }}" type="module"></script>
  <script src="{{ 'quantity-input.js' | asset_url }}" type="module"></script>
  <script src="{{ 'cart-drawer.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  html:has(dialog.cart-drawer[open]) { overflow: hidden; }
  .cart-drawer { --from: 100%; width: min(26rem, 100%); height: 100dvh; max-width: none; max-height: none; margin: 0; margin-inline-start: auto; padding: 0; border: 0; border-inline-start: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-fg); }
  .cart-drawer:dir(rtl) { --from: -100%; }
  .cart-drawer[open] { display: block; animation: cart-drawer-in 0.25s ease-out; }
  .cart-drawer::backdrop { background: var(--color-scrim); }
  .cart-drawer__panel { display: flex; flex-direction: column; height: 100%; }
  .cart-drawer__head { display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 1rem 0.5rem 1.25rem; border-block-end: 1px solid var(--color-border); }
  .cart-drawer__title { margin: 0; font-size: 1.125rem; }
  .cart-drawer__content { display: flex; flex: 1; flex-direction: column; min-height: 0; }
  .cart-drawer__form { display: flex; flex: 1; flex-direction: column; min-height: 0; }
  /* ul[role=list] in base.css resets the padding with a higher specificity: repeat the element. */
  ul.cart-drawer__items { flex: 1; margin: 0; padding: 0 1.25rem; overflow-y: auto; overscroll-behavior: contain; list-style: none; }
  .cart-drawer__item { display: grid; grid-template-columns: 4rem 1fr 2.75rem; gap: 0.25rem 0.75rem; align-items: start; padding-block: 1rem; border-block-end: 1px solid var(--color-border); }
  .cart-drawer__image { display: block; grid-row: span 2; aspect-ratio: var(--ratio-product); overflow: hidden; border-radius: var(--radius); background: var(--color-surface); }
  .cart-drawer__image img { width: 100%; height: 100%; object-fit: cover; }
  .cart-drawer__link { display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: var(--font-weight-strong); text-decoration: none; }
  .cart-drawer__variant { font-size: 0.8125rem; }
  .cart-drawer__remove { grid-column: 3; grid-row: 1; justify-self: end; width: 2.75rem; height: 2.75rem; }
  .cart-drawer__qty { grid-column: 2 / -1; grid-row: 2; }
  .cart-drawer__summary { padding: 1rem 1.25rem; border-block-start: 1px solid var(--color-border); background: var(--color-surface); }
  .cart-drawer__subtotal { display: flex; justify-content: space-between; margin: 0; }
  .cart-drawer__note { margin: 0; font-size: 0.8125rem; }
  .cart-drawer__empty { padding: 1.25rem; justify-items: start; }
  .cart-drawer__content .form-error { margin: 0.75rem 1.25rem 0; }
  cart-items[aria-busy='true'] .cart-drawer__form { opacity: 0.5; pointer-events: none; }
  @keyframes cart-drawer-in { from { opacity: 0; transform: translateX(var(--from)); } }
  @media (prefers-reduced-motion: reduce) { .cart-drawer[open] { animation: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
