{% comment %}
  Grid of all collections, paginated.
{% endcomment %}

<div class="container section">
  {%- render 'breadcrumbs', kind: 'collections' -%}
  <h1>{{ 'collections.title' | t }}</h1>

  {%- paginate collections by 24 -%}
    <ul class="product-grid collections-grid" role="list">
      {%- for collection in collections -%}
        <li class="product-card">
          {%- if collection.featured_image -%}
            {%- render 'image',
              image: collection.featured_image,
              sizes: '(min-width: 56em) 25vw, 50vw',
              widths: '240, 360, 480, 640, 800',
              width: 800,
              eager: forloop.first,
              alt: collection.title
            -%}
          {%- else -%}
            <div class="product-card__media"></div>
          {%- endif -%}
          <h2 class="product-card__title">
            <a class="product-card__link" href="{{ collection.url }}">{{ collection.title }}</a>
          </h2>
          <p class="mono muted collections-grid__count">{{ 'collection.product_count' | t: count: collection.products_count }}</p>
        </li>
      {%- endfor -%}
    </ul>
    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .collections-grid { margin-block-start: 2rem; }
  .collections-grid__count { font-size: 0.8125rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection list",
  "settings": []
}
{% endschema %}
