{% doc %}
  The accepted payment methods as small icons, for any section that takes theme blocks: under the buy buttons on a
  product page, in a content section, on a page about payment. A choice of full color or grayscale. Nothing renders
  when the store has no payment methods. Decision record: docs/decisions/034-payment-icons-are-one-snippet-with-a-one-color-option.md.

  @example
  {% content_for 'block', type: 'payment-icons', id: 'payment' %}
{% enddoc %}

<div class="payment-block" {{ block.shopify_attributes }}>
  {%- render 'payment-icons', mono: block.settings.mono -%}
</div>

{% schema %}
{
  "name": "Payment icons",
  "settings": [
    { "type": "checkbox", "id": "mono", "label": "Show in grayscale", "default": false, "info": "Softens the icons so they sit quietly on the page. Shopify's icons are full color cards, so this is grayscale, not a single brand color." }
  ],
  "presets": [{ "name": "Payment icons" }]
}
{% endschema %}
