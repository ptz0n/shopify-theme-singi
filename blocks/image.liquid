{% doc %}
  Merchant-chosen image with a fixed aspect ratio. Always lazy loaded: if you
  need an above-the-fold image, use the hero section instead.

  @example
  {% content_for 'block', type: 'image', id: 'photo' %}
{% enddoc %}

{%- assign s = block.settings -%}

{%- if s.image != blank -%}
  <div class="media media--{{ s.ratio }}" {{ block.shopify_attributes }}>
    {%- render 'image', image: s.image, sizes: '(min-width: 56em) 50vw, 100vw', widths: '480, 720, 960, 1200, 1600', width: 1600 -%}
    {%- render 'ai-label', alt: s.image.alt -%}
  </div>
{%- else -%}
  {%- render 'placeholder', label: 'Image: choose an image in the block settings' -%}
{%- endif -%}

{% stylesheet %}
  .media { position: relative; overflow: hidden; border-radius: var(--radius); background: var(--color-surface); }
  .media--square { aspect-ratio: 1; }
  .media--portrait { aspect-ratio: 4 / 5; }
  .media--landscape { aspect-ratio: 16 / 10; }
  .media:not(.media--adapt) img { width: 100%; height: 100%; object-fit: cover; }
{% endstylesheet %}

{% schema %}
{
  "name": "Image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "adapt", "label": "Original" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "adapt"
    }
  ],
  "presets": [{ "name": "Image" }]
}
{% endschema %}
