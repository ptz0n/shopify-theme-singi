{% doc %}
  One feature in a feature list: an optional image (or, without one, an optional icon), a heading and a line of
  text. A block with neither heading nor text renders nothing, so its text can be connected to a metafield (a
  dynamic source) and the item disappears for products without that data. The image is always lazy loaded. Private
  to the feature list block.

  @example
  {% content_for 'block', type: '_feature-item', id: 'fabric' %}
{% enddoc %}

{%- assign s = block.settings -%}

{%- if s.heading != blank or s.text != blank -%}
  <div class="feature-item" role="listitem" {{ block.shopify_attributes }}>
    {%- if s.image != blank -%}
      <div class="feature-item__media">
        {%- render 'image',
          image: s.image,
          sizes: '(min-width: 56em) 25vw, (min-width: 40em) 33vw, 100vw',
          widths: '320, 480, 640, 800, 1000',
          width: 1000
        -%}
        {%- render 'ai-label', alt: s.image.alt -%}
      </div>
    {%- elsif s.icon != 'none' -%}
      {%- render 'icon', name: s.icon, class: 'feature-item__icon' -%}
    {%- endif -%}
    {%- if s.heading != blank -%}
      <p class="feature-item__heading">{{ s.heading }}</p>
    {%- endif -%}
    {%- if s.text != blank -%}
      <p class="feature-item__text muted">{{ s.text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .feature-item { display: grid; gap: 0.5rem; align-content: start; }
  .feature-item__media { position: relative; aspect-ratio: var(--ratio, 4 / 5); overflow: hidden; border-radius: var(--radius); background: var(--color-surface); }
  .feature-item__media img { width: 100%; height: 100%; object-fit: cover; }
  .feature-item__icon { width: 2rem; height: 2rem; }
  .feature-item__heading { margin: 0.25rem 0 0; font-weight: var(--font-weight-strong); }
  .feature-item__text { margin: 0; font-size: 0.9375rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Feature item",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon (used when there is no image)",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "truck", "label": "Delivery truck" },
        { "value": "return", "label": "Return arrow" },
        { "value": "shield", "label": "Shield with check" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "star", "label": "Star" },
        { "value": "gift", "label": "Gift" },
        { "value": "support", "label": "Headset" },
        { "value": "lock", "label": "Lock" },
        { "value": "clock", "label": "Clock" },
        { "value": "package", "label": "Package" },
        { "value": "check", "label": "Check mark" },
        { "value": "heart", "label": "Heart" }
      ],
      "default": "none"
    },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "inline_richtext", "id": "text", "label": "Text" }
  ]
}
{% endschema %}
