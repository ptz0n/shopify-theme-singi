{% doc %}
  Option picker. Radios with real labels: the change handler lives in
  assets/product-form.js and refetches this section through the Section
  Rendering API. Options and values come from product.options_with_values, so
  no loop ever walks the variants array. Each option also carries the price of the variant it selects (data-price) and, only when that
  variant's unit price differs from the current one, the unit price (data-unit-price,
  data-unit-label; absent means unchanged), so assets/product-form.js can show them at once
  instead of waiting for the server. Private to product sections.
{% enddoc %}

{%- unless product.has_only_default_variant -%}
  {%- assign current = product.selected_or_first_available_variant -%}
  <div class="variant-picker stack" {{ block.shopify_attributes }}>
    {%- for option in product.options_with_values -%}
      {%- assign option_index = forloop.index -%}
      <fieldset class="variant-option">
        <legend>{{ option.name }}</legend>
        <div class="variant-option__values">
          {%- for value in option.values -%}
            {%- assign input_id = 'option-' | append: section.id | append: '-' | append: option_index | append: '-' | append: forloop.index -%}
            {%- assign target = value.variant.url | default: product.url -%}
            <input
              class="chip-input visually-hidden"
              type="radio"
              id="{{ input_id }}"
              name="option-{{ option_index }}"
              value="{{ value.name | escape }}"
              data-option-url="{{ target }}"
              data-variant-id="{{ value.variant.id }}"
              data-available="{{ value.variant.available }}"
              data-price="{{ value.variant.price | money | escape }}"
              {%- if value.variant.unit_price_measurement and value.variant.unit_price != current.unit_price -%}
                {%- capture unit_visible -%}{%- render 'unit-price', variant: value.variant, part: 'visible' -%}{%- endcapture -%}
                {%- capture unit_label -%}{%- render 'unit-price', variant: value.variant, part: 'label' -%}{%- endcapture -%}
                data-unit-price="{{ unit_visible | strip | escape }}"
                data-unit-label="{{ unit_label | strip | escape }}"
              {%- endif %}
              {% if value.selected %}checked{% endif %}
              {% unless value.variant %}disabled{% endunless %}
            >
            <label class="chip{% unless value.available %} chip--unavailable{% endunless %}" for="{{ input_id }}">
              {%- if value.swatch.color -%}
                <span class="chip__swatch" style="--swatch: {{ value.swatch.color }}"></span>
              {%- endif -%}
              {{ value.name }}
            </label>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endfor -%}
  </div>
{%- endunless -%}

{% stylesheet %}
  .variant-option { min-width: 0; padding: 0; border: 0; }
  .variant-option legend { padding: 0; }
  .variant-option__values { display: flex; flex-wrap: wrap; gap: 0.5rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Variant picker",
  "settings": []
}
{% endschema %}
