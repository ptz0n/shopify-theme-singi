{% doc %}
  Vertical whitespace.

  @example
  {% content_for 'block', type: 'spacer', id: 'gap' %}
{% enddoc %}

<div style="height: {{ block.settings.height }}px" aria-hidden="true" {{ block.shopify_attributes }}></div>

{% schema %}
{
  "name": "Spacer",
  "settings": [
    { "type": "range", "id": "height", "label": "Height", "min": 8, "max": 160, "step": 8, "unit": "px", "default": 32 }
  ],
  "presets": [{ "name": "Spacer" }]
}
{% endschema %}
