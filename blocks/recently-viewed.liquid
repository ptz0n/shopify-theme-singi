{% doc %}
  Products the visitor looked at recently, as a row of product cards.

  Nothing is rendered on the server: assets/product-form.js remembers the handle of every product
  page the visitor opens (localStorage `singi-recent`, newest first, up to 12), and this block
  fetches a card for each one through templates/product.recent.liquid when it nears the viewport.
  The visitor's own browser holds the list, so it is private, needs no cookies or account, and the
  page stays fully cacheable. A first-time visitor sees nothing: the block stays hidden until there
  is something to show, and the product being viewed is never listed.

  Skeleton cards hold the space while the real cards load, so the page does not shift.
  Works in any content section; on the product page it is added below the product.

  @example
  {% content_for 'block', type: 'recently-viewed', id: 'recent' %}
{% enddoc %}

{%- liquid
  assign s = block.settings
  assign heading = s.heading | default: 'products.recently_viewed' | t
-%}

<recently-viewed
  class="recent"
  data-current="{{ product.handle }}"
  data-limit="{{ s.limit }}"
  data-url="{{ routes.root_url }}products/"
  hidden
  {{ block.shopify_attributes }}
>
  <h2>{{ heading }}</h2>
  <ul class="product-grid" role="list"></ul>
</recently-viewed>

{%- render 'placeholder', label: 'Recently viewed products: shows only what this visitor has opened. Empty until they have viewed some.' -%}

<script src="{{ 'recently-viewed.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .recent h2 { margin-block-end: 1rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the translated default." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
