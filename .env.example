# Copy to .env (git-ignored). Never commit real values.

# Theme Access password for the dev store. Create it in the Shopify admin:
# Apps > Theme Access > Create password. Shopify emails it once.
SHOPIFY_CLI_THEME_TOKEN=shptka_xxxxxxxxxxxxxxxxxxxxxxxx

# Dev store handle or myshopify.com domain.
SINGI_STORE=your-store

# Optional: stores where scripts may touch the live theme (npm run push uses --allow-live).
# Leave empty to use only unpublished themes (npm run dev:push).
# SINGI_LIVE_STORES=your-store.myshopify.com

# Storefront password, only if the dev store is password protected and you
# run Lighthouse against it (npm run perf:lighthouse). Not the Theme Access password.
SINGI_PASSWORD=

# Optional: Shopify web bot authentication, so browser scripts that load many pages are not
# throttled (HTTP 429) when they hit the storefront directly. Three headers, sent only to the
# origin being tested: Signature-Agent "https://shopify.com", Signature (CRAWL_SIGN) and
# Signature-Input (CRAWL_SIGN_INPUT, which carries the expiry). Ask Shopify for a signature for
# your store; it expires. See scripts/lib/crawl-sign.mjs.
CRAWL_SIGN=
CRAWL_SIGN_INPUT=
