{
  "sections": {
    "main": {
      "type": "content",
      "blocks": {
        "intro": {
          "type": "heading",
          "settings": {
            "text": "Content blocks",
            "tag": "h1",
            "size": "lg"
          }
        },
        "quote": {
          "type": "quote",
          "settings": {
            "quote": "Arrived in two days and fits better than anything I have owned.\nWorth every krona.",
            "author": "A customer",
            "source": "Ume\u00e5"
          }
        },
        "grid": {
          "type": "product-grid",
          "settings": {
            "collection": "mock-new-arrivals",
            "limit": 4
          }
        },
        "signup": {
          "type": "newsletter",
          "settings": {
            "text": "One email a month. No noise."
          }
        },
        "usp": {
          "type": "usp-list",
          "settings": {
            "layout": "row"
          },
          "blocks": {
            "a": {
              "type": "_usp-item",
              "settings": {
                "icon": "truck",
                "heading": "Fast delivery",
                "text": "Ships within one to two business days."
              }
            },
            "b": {
              "type": "_usp-item",
              "settings": {
                "icon": "return",
                "heading": "Free returns",
                "text": "Thirty days to change your mind."
              }
            },
            "c": {
              "type": "_usp-item",
              "settings": {
                "icon": "shield",
                "heading": "Secure payment",
                "text": "Pay the way you prefer, safely."
              }
            },
            "d": {
              "type": "_usp-item",
              "settings": {
                "icon": "none",
                "heading": "",
                "text": ""
              }
            }
          },
          "block_order": [
            "a",
            "b",
            "c",
            "d"
          ]
        },
        "features": {
          "type": "feature-list",
          "settings": {
            "columns": "3",
            "ratio": "portrait"
          },
          "blocks": {
            "a": {
              "type": "_feature-item",
              "settings": {
                "image": "shopify://shop_images/hoodie-1.png",
                "heading": "Heavyweight cotton",
                "text": "Brushed fleece inside, 420 gsm."
              }
            },
            "b": {
              "type": "_feature-item",
              "settings": {
                "image": "shopify://shop_images/hoodie-1.png",
                "heading": "Cut to last",
                "text": "Reinforced seams at every stress point."
              }
            },
            "c": {
              "type": "_feature-item",
              "settings": {
                "icon": "leaf",
                "heading": "Made responsibly",
                "text": "Organic cotton, certified mills."
              }
            },
            "d": {
              "type": "_feature-item",
              "settings": {
                "icon": "none",
                "heading": "",
                "text": ""
              }
            }
          },
          "block_order": [
            "a",
            "b",
            "c",
            "d"
          ]
        },
        "pay_color": {
          "type": "payment-icons",
          "settings": {
            "mono": false
          }
        },
        "pay_mono": {
          "type": "payment-icons",
          "settings": {
            "mono": true
          }
        }
      },
      "block_order": [
        "intro",
        "quote",
        "usp",
        "features",
        "pay_color",
        "pay_mono",
        "grid",
        "signup"
      ],
      "settings": {
        "width": "wide",
        "align": "left",
        "padding": 64
      }
    },
    "hero-overlay": {
      "type": "hero",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Hero, text over the image",
            "tag": "h2",
            "size": "lg"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Two layouts of one section. Beside the text, contrast never depends on the picture.</p>",
            "size": "large"
          }
        },
        "cta": {
          "type": "button",
          "settings": {
            "label": "Shop new arrivals",
            "link": "/collections/mock-new-arrivals",
            "style": "primary"
          }
        }
      },
      "block_order": [
        "heading",
        "text",
        "cta"
      ],
      "settings": {
        "image": "shopify://shop_images/hoodie-1.png",
        "layout": "overlay",
        "height": "medium",
        "align": "start",
        "overlay": 40
      }
    },
    "hero-split": {
      "type": "hero",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Hero, image beside the text",
            "tag": "h2",
            "size": "lg"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Two layouts of one section. Beside the text, contrast never depends on the picture.</p>",
            "size": "large"
          }
        },
        "cta": {
          "type": "button",
          "settings": {
            "label": "Shop new arrivals",
            "link": "/collections/mock-new-arrivals",
            "style": "primary"
          }
        }
      },
      "block_order": [
        "heading",
        "text",
        "cta"
      ],
      "settings": {
        "image": "shopify://shop_images/hoodie-1.png",
        "layout": "split",
        "height": "medium",
        "align": "start",
        "overlay": 40
      }
    }
  },
  "order": [
    "main",
    "hero-overlay",
    "hero-split"
  ]
}
